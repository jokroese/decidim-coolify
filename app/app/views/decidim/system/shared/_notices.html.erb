<%= display_flash_messages %>

<% if !setup_sign_in_page? && setup_mail_pending? %>
  <%= cell "decidim/announcement",
           setup_text("email_notice"),
           callout_class: "warning" %>
<% end %>

<% if !setup_sign_in_page? && setup_first_run? %>
  <% guide = link_to t(".our_getting_started_guide"),
                     "https://github.com/jokroese/decidim-coolify#set-up",
                     target: "_blank", rel: "noopener noreferrer" %>

  <%= cell "decidim/announcement", t(".no_organization_warning_html", guide:), callout_class: "warning" %>
<% end %>
