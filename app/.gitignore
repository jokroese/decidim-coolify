# Local configuration and secrets.
/.env*
!/.env.example
/.envrc
/.rbenv-vars
/config/*.key
/config/credentials*.enc
/config/credentials/

# Installed dependencies.
/.bundle/
/node_modules/
/vendor/bundle/

# Runtime data and caches; retain empty directories in a clean checkout.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
!/tmp/storage/
/tmp/storage/*
!/tmp/storage/.keep
/storage/*
!/storage/.keep
/.sass-cache/
/*.tsbuildinfo

# Generated by the pinned application dependencies during the image build.
/app/views/static/api/docs/
/public/assets/
/public/decidim-packs/
/public/packs-test/
/public/sw.js*
/tailwind.config.js
