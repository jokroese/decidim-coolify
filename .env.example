# Developers: see docs/CONFIGURATION.md for meanings and runtime mappings.
# Collectives: follow README.md and enter settings in Coolify.
#
# Copy to .env only for local Compose interpolation. Compose does not inject
# every variable from this file automatically; compose.yaml maps runtime values.
# Do not commit a populated .env or share Coolify's resolved deployment config.

# The application image is pinned in compose.yaml, not an environment variable.
# Domain, credentials and installation-specific settings belong in Coolify.

# Coolify-generated values. Keep identifiers stable across deploys and share each
# credential across the app roles that use it. The bootstrap password is web-only.
SERVICE_USER_DATABASE=replace-with-coolify-generated-user
SERVICE_PASSWORD_64_DATABASE=replace-with-coolify-generated-password
SERVICE_PASSWORD_64_REDIS=replace-with-coolify-generated-password
SERVICE_PASSWORD_64_RAILS=replace-with-coolify-generated-secret
SERVICE_PASSWORD_64_ENCRYPTIONPRIMARY=replace-with-coolify-generated-secret
SERVICE_PASSWORD_64_ENCRYPTIONDETERMINISTIC=replace-with-coolify-generated-secret
SERVICE_PASSWORD_64_ENCRYPTIONSALT=replace-with-coolify-generated-secret
SERVICE_PASSWORD_64_ADMIN=replace-with-coolify-generated-password

# In Coolify, declare SERVICE_URL_WEB_3000: / on web and set the web domain.
# This value shows the corresponding local Compose interpolation input.
SERVICE_URL_WEB_3000=https://participate.example.org

# Required mail and bootstrap settings.
SMTP_ADDRESS=smtp.example.org
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_DOMAIN=example.org
DECIDIM_MAILER_SENDER=participation@example.org
SYSTEM_ADMIN_EMAIL=admin@example.org

# Optional settings.
SMTP_PORT=587
# For implicit TLS on port 465 set SMTP_TLS=true. STARTTLS is required otherwise.
SMTP_TLS=false
SMTP_AUTHENTICATION=plain
DECIDIM_APPLICATION_NAME=Community participation
RAILS_LOG_LEVEL=info

# Optional inactive-account retention policy.
ENABLE_INACTIVE_ACCOUNT_CLEANUP=false
